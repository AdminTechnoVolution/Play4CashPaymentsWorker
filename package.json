{
  "name": "play4cash-payments-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Procesador independiente de pagos P4C; sin API de jugadores",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "node --test test/*.test.cjs",
    "check:shared": "node scripts/shared-sources.cjs check",
    "sync:shared": "node scripts/shared-sources.cjs sync",
    "prebuild": "npm run check:shared",
    "package:azure": "npm run build && node scripts/package-azure.cjs",
    "pretest": "npm run build",
    "admin:mfa": "node scripts/admin-mfa.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.1",
    "mongoose": "9.7.2",
    "nodemailer": "^8.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "typescript": "^5.7.3"
  }
}

# APP SERVICE DEL WORKER: Play4CashPaymentsWorker
# Comando de inicio: npm start. Paquete: deployment.zip (npm run package:azure).
# Valores vacíos: completar con tus datos. No subir secretos reales a Git.
# Azure proporciona PORT. No necesita Redis, JWT ni PAYMENTS_WORKER.

# VALORES LISTOS PARA COPIAR (pagos sandbox, sin dinero real)
NODE_ENV=production
FINANCE_V2_ENABLED=true
PAYMENTS_DEPOSITS_ENABLED=true
PAYMENTS_WITHDRAWALS_ENABLED=true
NOWPAYMENTS_BASE_URL=https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_SANDBOX_CASE=success
# Solo para desplegar el ZIP ya compilado indicado arriba: Azure no debe reconstruirlo.
SCM_DO_BUILD_DURING_DEPLOYMENT=false

# TUS DATOS: completar antes de desplegar
# Copiar MONGO_URI de la API: misma base MongoDB con transacciones.
MONGO_URI=
# Copiar NOWPAYMENTS_API_KEY de la API, de la misma cuenta sandbox.
NOWPAYMENTS_API_KEY=
# Copiar NOWPAYMENTS_IPN_URL de la API: apunta al GATEWAY, nunca a este worker.
NOWPAYMENTS_IPN_URL=

# Exclusivas del worker: inicio de sesión en NOWPayments SANDBOX.
NOWPAYMENTS_PAYOUT_EMAIL=
NOWPAYMENTS_PAYOUT_PASSWORD=
# Semilla Base32 del 2FA de payouts; NO el código temporal de seis dígitos.
# Obtener durante enrolamiento 2FA de la cuenta; consultar a NOWPayments si no está disponible.
NOWPAYMENTS_PAYOUT_TOTP_SECRET=

# Copiar los tres valores del correo emisor configurado en la API.
EMAIL_SERVICE=
EMAIL_FROM=
EMAIL_PASS=

# Con ambos interruptores en true, el arranque exige claves, callback y credenciales de payouts.
# Para probar solo depósitos, poner PAYMENTS_WITHDRAWALS_ENABLED=false EN API Y WORKER.
# No agregar lista de países ni NOWPAYMENTS_USDT_NETWORKS={}: las redes son automáticas.
# Instrucciones: CONFIGURACION-AZURE.md. Health check de Azure: /health. Always On: activado.
